# SQLite
DB_PATH=./data/app.db
RUNTIME_LOCK_DB_PATH=./data/app.runtime_locks.sqlite

# Bybit public REST base (v5)
BYBIT_BASE_URL=https://api.bybit.com

# Background loops
COLLECT_INTERVAL_SEC=20
FUTURES_COLLECT_INTERVAL_SEC=900
RECO_INTERVAL_SEC=20
COLLECTOR_MAX_WORKERS=8
FUTURES_COLLECT_MAX_WORKERS=8
# Optional override for recommendation TTL. Leave empty to derive from RECO_INTERVAL_SEC.
RECO_TTL_SEC=
# Suppress near-duplicate republication of essentially the same live idea within cooldown.
RECO_REPUBLISH_COOLDOWN_SEC=3600
TOP_N=20

# Outcome processing cadence (decoupled from recommendation publishing)
OUTCOMES_INTERVAL_SEC=60
OUTCOMES_MAX_TO_PROCESS=200

# Venues: spot, linear (USDT Perp)
VENUES=linear
#VENUES=linear, spot

# Symbols to watch (small default set)
#SYMBOLS_SPOT=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,AAVEUSDT,XAUTUSDT,DOGEUSDT,BNBUSDT,AVAXUSDT,SUIUSDT,NEARUSDT,MNTUSDT,LTCUSDT,DOTUSDT,ADAUSDT,LINKUSDT,TRXUSDT,XLMUSDT,ATOMUSDT,UNIUSDT,OPUSDT,ARBUSDT,FILUSDT,RNDRUSDT
# Keep non-standard / pre-listing symbols out of linear until they are confirmed tradeable on the target venue.
SYMBOLS_LINEAR=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,AAVEUSDT,HYPEUSDT,XAUTUSDT,DOGEUSDT,BNBUSDT,AVAXUSDT,SUIUSDT,NEARUSDT,MNTUSDT,LTCUSDT,DOTUSDT,ADAUSDT,LINKUSDT,TRXUSDT,XLMUSDT,ATOMUSDT,UNIUSDT,OPUSDT,ARBUSDT,FILUSDT,BCHUSDT,APTUSDT,INJUSDT,FETUSDT,ENAUSDT,ONDOUSDT,1000PEPEUSDT,WIFUSDT,POPCATUSDT,JUPUSDT,TIAUSDT,WLDUSDT,TONUSDT,RUNEUSDT,IMXUSDT,FTMUSDT,GALAUSDT,HBARUSDT,KASUSDT,LDOUSDT,PENDLEUSDT,SEIUSDT,CRVUSDT,CFXUSDT,CHZUSDT,CYBERUSDT,EGLDUSDT,KNCUSDT,XMRUSDT,WOOUSDT,ALGOUSDT,APEUSDT,ARKMUSDT,AXSUSDT,BAKEUSDT,BICOUSDT,BIGTIMEUSDT,COMPUSDT,CTSIUSDT,EDUUSDT,FLOWUSDT,FXSUSDT,HFTUSDT,HIFIUSDT,IOSTUSDT,KAVAUSDT,LPTUSDT,MAGICUSDT,PERPUSDT,RAYUSDT,SANDUSDT,SNXUSDT,STORJUSDT,WAVESUSDT,WAXPUSDT,XTZUSDT,YGGUSDT,ZRXUSDT


# Recommender waits for collector warm-up before publishing on a fresh/empty DB.
# Ratio applies per active venue; e.g. 0.85 means at least 85% of symbols must
# have fresh ticker+1m data and enough multi-timeframe history.
RECO_WARMUP_MIN_READY_RATIO=0.85
RECO_WARMUP_MIN_READY_SYMBOLS=1
RECO_WARMUP_LOG_COOLDOWN_SEC=120

# Risk limits (JSON string)
RISK_LIMITS_JSON={"max_concurrent_bots":4,"max_daily_dd_usdt":200.0,"cooldown_after_loss_min":30,"max_symbol_bots":1}

# Recommender thresholds
MIN_SCORE_TO_RECOMMEND=0.08
MIN_CONF_TO_RECOMMEND=0.52

# Heuristic fees (bps) if not known; used in cost model
TAKER_FEE_BPS_SPOT=10
TAKER_FEE_BPS_LINEAR=6

# Master key for encrypting private keys (optional; project runs without it)
# Generate example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=
ADMIN_API_KEY=

# Outcome labeling / calibration
# Fallback horizon for unknown bot types only. Current built-in bot types use per-bot horizons from app/outcomes.py.
# Legacy name OUTCOME_HORIZON_SEC is still accepted for backward compatibility.
OUTCOME_HORIZON_FALLBACK_SEC=900
CALIB_MIN_SAMPLES=80

# If 1, engine converts low-confidence candidates to status=no_trade (recommended).
# If 0, engine still publishes best candidates; operator filters by confidence in UI.
REQUIRE_CONF_GATE=1

# Skip symbol if newest 1m candle is older than this (seconds)
STALE_DATA_MAX_SEC=300

# Telegram alerts (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTIMENT_INTERVAL_SEC=60

# Optional local LLM reviewer over multi-timeframe OHLCV (text-only; good fit for local Ollama)
# Advisory = stores the LLM opinion in reasons_json/decision_log, but does not affect status.
# Gate     = if LLM confidently disagrees with engine execution_direction, candidate becomes no_trade.
LLM_REVIEWER_ENABLED=0
LLM_REVIEWER_MODE=advisory
LLM_REVIEWER_PROVIDER=ollama
LLM_REVIEWER_URL=http://127.0.0.1:11434
LLM_REVIEWER_MODEL=qwen3:8b
LLM_REVIEWER_TIMEOUT_SEC=60
LLM_REVIEWER_TFS=15m,1h,4h
LLM_REVIEWER_CANDLES_PER_TF=32
LLM_REVIEWER_MAX_CANDIDATES=24
LLM_REVIEWER_MAX_WORKERS=2
LLM_REVIEWER_MIN_CONFIDENCE=0.65
LLM_REVIEWER_CADENCE_SEC=300
LLM_REVIEWER_KEEP_ALIVE=90s
